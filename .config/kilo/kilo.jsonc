{
  "$schema": "https://app.kilo.ai/config.json",
  "small_model": "kilo/~openai/gpt-luna-latest",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
  },
  "agent": {
    "title": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
    "summary": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
    "compaction": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
  },
  "mcp": {
    "sandbox": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/mcp-sandbox"],
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ],
      "enabled": false
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": true
    },
  },
  "provider": {
    "proxy": {
      "name": "Local proxy",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "^gpt-image"
            ]
          }
        },
      },
      "models": {
        "haiku": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none",
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
        "sonnet": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "disabled": true,
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
        "opus": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "disabled": true,
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
      },
    },
    "ckey": {
      "name": "CKey",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.xah.io/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "(?i)image",
              "(?i)veo",
              "(?i)seedance"
            ]
          }
        },
      },
      "env": [
        "CKEY_API_KEY",
      ],
      "models": {
        "forbiddengun/architect": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/gemini": {
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536,
          },
        },
        "forbiddengun/glm": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
        },
        "forbiddengun/deepseek": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/qwen": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
      },
    },
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "recall": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "semantic_search": "allow",
    "task": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "serena_open_dashboard": "deny",
    "serena_initial_instructions": "allow",
    "serena_activate_project": "allow",
    "serena_onboarding": "allow",
    "serena_list_dir": "allow",
    "serena_find_file": "allow",
    "serena_read_file": "allow",
    "serena_get_diagnostics_for_file": "allow",
    "serena_search_for_pattern": "allow",
    "serena_get_symbols_overview": "allow",
    "serena_find_symbol": "allow",
    "serena_list_memories": "allow",
    "serena_get_current_config": "allow",
    "serena_find_declaration": "allow",
    "serena_find_implementations": "allow",
    "serena_find_referencing_symbols": "allow",
    "serena_read_memory": "allow",
  },
  "experimental": {
    "batch_tool": true,
    "openTelemetry": false,
    "swe_pruner": true,
  },
  "remote_control": true,
  "plugin": [
    "opencode-models-discovery@latest",
    "@tarquinen/opencode-dcp@latest",
    "@bybrawe/opencode-loop@latest",
    //"@daytona/opencode",
  ],
}
