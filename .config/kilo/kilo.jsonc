{
  "$schema": "https://app.kilo.ai/config.json",
  "small_model": "kilo/kilo-auto/free",
  "default_agent": "autonomous",
  "instructions": [
    "~/.agents/instructions/agent-instructions.md",
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
  },
  "agent": {
    "title": {
      "model": "kilo/kilo-auto/free",
    },
    "summary": {
      "model": "kilo/kilo-auto/free",
    },
    //"compaction": {
    //  "model": "github-copilot/gpt-5.4",
    //},
    "general": {
      "description": "USE SPARINGLY: only for vague questions with no specialized subagent match. Prefer explore for codebase nav, plan for design, code for implementation, debug for bugs.",
      "model": "github-copilot/claude-sonnet-4.5",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "allow",
        "kilo_memory_recall": "allow",
        "recall": "allow",
      },
    },
    "explore": {
      "description": "Can only use tools with no side-effect",
      "model": "github-copilot/claude-haiku-4.5",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "allow",
        "kilo_memory_recall": "allow",
        "recall": "allow",
      },
    },
    "orchestrator": {
      "hidden": true,
      "description": "Deprecated workflow orchestrator for coordinating complex tasks by delegating to specialized agents",
      "model": "kilo/openai/gpt-5.6-luna",
      "variant": "max",
      "options": {
        "reasoningEffort": "high",
      },
    },
    "ask": {
      "hidden": true,
      "description": "A knowledgeable technical assistant focused on answering questions without changing your codebase",
      "model": "kilo/kilo-auto/free",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "deny",
        "kilo_memory_recall": "deny",
        "recall": "allow",
      },
    },
    "plan": {
      "hidden": true,
      "mode": "primary",
      "description": "System design, architecture decisions, technical planning, and implementation roadmaps. Use for: design docs, architecture, API contracts, data modeling, tech stack decisions, or planning complex features.",
      "model": "proxy/forbiddengun/auto-frontier",
      "variant": "high",
      "options": {
        "reasoningEffort": "high",
      },
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "allow",
        "kilo_memory_recall": "allow",
        "recall": "allow",
      },
    },
    "code": {
      "mode": "subagent",
      "description": "Writes, refactors, and debugs code. Use for: implementing features, fixing bugs, refactoring, writing tests, and any code-level work. Full tool access. Must pass detailed implementation plan (file, not just plain prompt) before calling, only delegate the implementation of functional unit not every decision, each delegation scope must be small (1 smallest unit of work per delegation) to implement in minutes not hours. Reason is that we want to avoid drift and invented details due to poor delegation. Split the work and delegate multiple times if plan is big. Architecture design, contract and implementation plan must be controlled/synthesized by the main agent before delegating to this subagent for implementation.",
      "model": "kilo/stealth/ox-alpha", // good overall but ignored rules and don't load skills proactively, often make half-hearted claims without verification. Usually decide itself on user behalf without asking. Dark horse!
      "variant": "high",
      "options": {
        "reasoningEffort": "high",
      },
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "allow",
        "kilo_memory_recall": "allow",
        "recall": "allow",
      },
      "prompt": "Execute approved architectural plans with explicit functional units, contracts, and acceptance criteria faithfully. Execute only a clear, bounded request whose scope, contracts, and success criteria are already explicit; otherwise, return a planning handoff request rather than inventing a design.\n\nExecution protocol:\n1. Parse the delegated plan or direct request into discrete functional units with clear boundaries.\n2. Confirm each unit matches its authorized scope before changing code. If a requirement is ambiguous or contradictory, stop and report the deviation rather than reinterpreting it.\n3. Activate `code-craft` skill before implementation. Use memory recall and targeted inspection to follow established project conventions.\n4. Implement only the assigned units. Do not add features, perform unrelated refactors, change contracts, or make strategic architectural decisions without authorization.\n5. Validate each completed unit against its acceptance criteria using the relevant project checks (tests, lint, type checks, build) and report the evidence.\n6. Surface every material deviation: missing dependencies, contract mismatches, plan gaps, or performance concerns. Never silently adapt the plan.\n\nConstraints:\n- Do not redesign architecture or change interfaces beyond the changes explicitly authorized by the approved plan or direct request.\n- Do not delegate further; centralized orchestration remains with the main agent.\n- Do not claim completion without validation evidence.\n- If blocked, report the blocker and its context; do not guess or substitute an unapproved workaround.\n\nReturn using this contract:\n## 1. Objective Recap\n## 2. Units Completed (with validation evidence per unit)\n## 3. Deviations & Blockers (or NONE)\n## 4. Confidence & Caveats\n## 5. Done Signal\nTASK_COMPLETE",
    },
    "debug": {
      "mode": "all",
      "description": "Systematic troubleshooting and root cause analysis. Use for: diagnosing test failures, CI/CD failures, runtime errors, performance issues, and hard-to-reproduce bugs.",
      "model": "kilo/tencent/hy3:free",
      "variant": "high",
      "options": {
        "reasoningEffort": "high",
      },
      "permission": {
        "bash": "allow",
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "semantic_search": "allow",
        "codesearch": "allow",
        "skill": "allow",
        "lsp": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "question": "allow",
        "doom_loop": "allow",
        "kilo_memory_save": "allow",
        "kilo_memory_recall": "allow",
        "recall": "allow",
      },
    },
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": true
    },
  },
  "provider": {
    "proxy": {
      "name": "Local proxy",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "env": [
        "LLM_BROKER_API_KEY",
      ],
      "models": {
        "forbiddengun/auto-frontier": {
          "modalities": {
            "input": [
              "text",
              "image",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 500000,
            "output": 64000,
          },
        },
        "forbiddengun/auto-small": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32768,
          },
        },
        "forbiddengun/auto-free": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32768,
          },
        },
        "forbiddengun/coder": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32768,
          },
        },
        "forbiddengun/grok": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 500000,
            "output": 500000,
          },
        },
        "forbiddengun/gpt": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
        },
        "forbiddengun/claude": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
        },
        "forbiddengun/gemini": {
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536,
          },
        },
        "forbiddengun/deepseek": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/glm": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
        },
        "forbiddengun/kimi": {
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 262144,
            "output": 262144,
          },
        },
        "forbiddengun/mimo": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072,
          },
        },
        "forbiddengun/qwen": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
        "forbiddengun/minimax": {
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 512000,
            "output": 128000,
          },
        },
      },
    },
  },
  "permission": {
    "bash": {
      "git status *": "allow",
      "git log *": "allow",
      "git fetch *": "allow",
      "git ls-files *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "git remote -v *": "allow",
      "git init *": "allow",
      "git check-ignore *": "allow",
      "git checkout *": "allow",
      "git pull *": "allow",
      "git stash list *": "allow",
      "git grep *": "allow",
      "git ls-tree *": "allow",
      "git rev-parse *": "allow",
      "gh repo list *": "allow",
      "gh auth status *": "allow",
      "gh release list *": "allow",
      "gh run list *": "allow",
      "gh run watch *": "allow",
      "gh run view *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "brew list *": "allow",
      "brew search *": "allow",
      "brew tap-info *": "allow",
      "brew info *": "allow",
      "brew update *": "allow",
      "brew outdated *": "allow",
      "brew upgrade *": "allow",
      "cargo check *": "allow",
      "cargo test *": "allow",
      "cargo info *": "allow",
      "cargo doc *": "allow",
      "cargo fmt *": "allow",
      "cargo clippy *": "allow",
      "rustfmt *": "allow",
      "rustc *": "allow",
      "go mod *": "allow",
      "go get *": "allow",
      "go doc *": "allow",
      "go list *": "allow",
      "go build *": "allow",
      "go run *": "allow",
      "go test *": "allow",
      "go generate *": "allow",
      "go vet *": "allow",
      "gofmt *": "allow",
      "npm list *": "allow",
      "helm version *": "allow",
      "helm lint *": "allow",
      "pwd *": "allow",
      "awk *": "allow",
      "env *": "allow",
      "nl *": "allow",
      "true *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "wait *": "allow",
      "which *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "jq *": "allow",
      "sleep *": "allow",
      "timeout *": "allow",
      "grep *": "allow",
      "basename *": "allow",
      "uuidgen *": "allow",
      "tr *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "printf *": "allow",
      "command *": "allow",
      "curl *": "allow",
      "test *": "allow",
      "readlink *": "allow",
      "gtimeout *": "allow",
      "stat *": "allow",
      "chmod *": "allow",
      "time *": "allow",
      "read *": "allow",
      "mkdir *": "allow",
      "rmdir *": "allow",
      "ps *": "allow",
      "cmp *": "allow",
      "mktemp *": "allow",
      "lsof *": "allow",
      "pgrep *": "allow",
      "ss *": "allow",
      "fuser *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "bun x *": "allow",
    },
    "recall": {
      "search": "allow"
    },
    "read": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "codesearch": "allow",
    "external_directory": {
      "/tmp/*": "allow",
      "~/.agents/*": "allow",
      "~/.config/kilo/*": "allow",
    },
    "kilo_memory_recall": {
      "*": "allow",
    },
    "serena_initial_instructions": {
      "*": "allow"
    },
    "serena_activate_project": {
      "*": "allow"
    },
    "serena_list_dir": {
      "*": "allow"
    },
    "serena_find_file": {
      "*": "allow"
    },
    "serena_read_file": {
      "*": "allow"
    },
    "serena_get_diagnostics_for_file": {
