{
  "$schema": "https://app.kilo.ai/config.json",
  "small_model": "kilo/~openai/gpt-luna-latest",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
  },
  "agent": {
    "title": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
    "summary": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
    "compaction": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": true
    },
  },
  "provider": {
    "proxy": {
      "name": "Local proxy",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "^gpt-image"
            ]
          }
        },
      },
      "models": {
        "haiku": {},
        "sonnet": {},
        "opus": {},
      },
    },
    "ckey": {
      "name": "CKey",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.xah.io",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "(?i)image",
              "(?i)veo",
              "(?i)seedance"
            ]
          }
        },
      },
      "env": [
        "CKEY_API_KEY",
      ],
      "models": {
        "forbiddengun/architect": {},
        "forbiddengun/gemini": {},
        "forbiddengun/glm": {},
        "forbiddengun/deepseek": {},
        "forbiddengun/qwen": {},
      },
    },
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "recall": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "semantic_search": "allow",
    "task": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "serena_open_dashboard": "deny",
    "serena_initial_instructions": "allow",
    "serena_activate_project": "allow",
    "serena_onboarding": "allow",
    "serena_list_dir": "allow",
    "serena_find_file": "allow",
    "serena_read_file": "allow",
    "serena_get_diagnostics_for_file": "allow",
    "serena_search_for_pattern": "allow",
    "serena_get_symbols_overview": "allow",
    "serena_find_symbol": "allow",
    "serena_list_memories": "allow",
    "serena_get_current_config": "allow",
    "serena_find_declaration": "allow",
    "serena_find_implementations": "allow",
    "serena_find_referencing_symbols": "allow",
    "serena_read_memory": "allow",
  },
  "experimental": {
    "batch_tool": true,
    "openTelemetry": false,
    "swe_pruner": true,
  },
  "remote_control": true,
  "plugin": [
    "opencode-models-discovery@latest",
    "@tarquinen/opencode-dcp@latest",
    "@bybrawe/opencode-loop@latest",
    //"@daytona/opencode",
  ],
}
