          "modalities": {
            "input": [
              "text",
              "image",
              "video",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 512000,
            "output": 128000,
          },
        },
        "llm-agg/forbiddengun/auto-frontier": {
          "modalities": {
            "input": [
              "text",
              "image",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 500000,
            "output": 64000,
          },
        },
        "llm-agg/forbiddengun/auto-small": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32768,
          },
        },
        "llm-agg/forbiddengun/auto-free": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
