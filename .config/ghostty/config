# ==============================================================================
# Ghostty Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Typography
# ------------------------------------------------------------------------------
font-family = "Iosevka Nerd Font Mono"
font-size = 14
# Adjust line height / cell dimensions if desired (default: 1.0)
adjust-cell-width = 0
adjust-cell-height = 0

# ------------------------------------------------------------------------------
# Color Scheme & Theme
# ------------------------------------------------------------------------------
# Built-in Ghostty themes: "Gruvbox Dark", "Gruvbox Dark Hard", "Gruvbox Material Dark"
theme = "Gruvbox Dark Hard"

# ------------------------------------------------------------------------------
# Window Styling & Transparency
# ------------------------------------------------------------------------------
background-opacity = 0.92
background-blur = true

# macOS window chrome
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# Window state
maximize = true

# ------------------------------------------------------------------------------
# macOS Ergonomics (Option key as Alt / Meta)
# ------------------------------------------------------------------------------
# Treat Option key as Alt (for Zellij, Neovim, and shell shortcuts)
macos-option-as-alt = true

# Unbind Ghostty's default Alt+Arrow -> esc:b / esc:f overrides
# This prevents Alt+Right from triggering Zellij's Alt+f (ToggleFloatingPanes)
# and allows Zellij to receive proper Alt+Arrow navigation keys
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Clean window behavior (Background Quake daemon mode)
confirm-close-surface = false
quit-after-last-window-closed = false
initial-window = false
macos-hidden = never

# ------------------------------------------------------------------------------
# Cursor
# ------------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = true

# ------------------------------------------------------------------------------
# Mouse & Scrollback
# ------------------------------------------------------------------------------
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 100000000

# ------------------------------------------------------------------------------
# Link Handling (iTerm-style URL clicking)
# ------------------------------------------------------------------------------
# Automatically match URLs on hover with Command (macOS) / Ctrl (Linux)
link-url = true
# Show preview tooltip when hovering over detected URLs
link-previews = true

# ------------------------------------------------------------------------------
# Dropdown / Quick Terminal (Quake Hotkey Window)
# ------------------------------------------------------------------------------
# Global shortcut for Quake-style dropdown terminal.
# Uses `super+alt+t` (Opt+Cmd+T on macOS / Super+Alt+T on Linux)
# to avoid conflicting with macOS native Cmd+` (switch windows of the same app).
keybind = global:super+alt+t=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
