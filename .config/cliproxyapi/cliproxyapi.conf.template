      - name: "deepseek/deepseek-v4-pro"
        alias: "deepseek/deepseek-v4-pro"
      - name: "openai/gpt-5.6-terra"
        alias: "openai/gpt-5.6-terra"
      - name: "openai/gpt-5.6-luna"
        alias: "openai/gpt-5.6-luna"
      - name: "Kimi-K3"
