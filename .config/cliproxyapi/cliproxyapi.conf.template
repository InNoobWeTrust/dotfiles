host: "127.0.0.1"
port: 8317

api-keys: []

auth-dir: "${HOME}/.local/share/cli-proxy-api"

# Remote management configuration, used with EasyCLI or WebUI
remote-management:
  # Switch to enable remote management. If you deploy it on a server,
  # you need to set it to true to use EasyCLI or WebUI to connect to CLIProxyAPI
  # for management.
  # If you only use the API for local management, you can keep it as false.
  allow-remote: true

  # If you want to use EasyCLI or WebUI to manage CLIProxyAPI through the API,
  # you must set a Key.
  # If it is not set, it is considered that the API management function is
  # disabled, and you cannot use EasyCLI or WebUI to connect.
  # If you do not need to use EasyCLI or WebUI for management, you can leave it
  # blank.
  secret-key: "lorem"

# Claude API Keys
claude-api-key:
  - api-key: "${KILO_API_KEY}"
    base-url: "${KILO_BASE_URL}"
    models:
      - name: "openai/gpt-5.4"
      - name: "openai/gpt-5.4-mini"
      - name: "openai/gpt-5.5"
      - name: "openai/gpt-5.6-luna"
      - name: "openai/gpt-5.6-terra"
      - name: "openai/gpt-5.6-sol"
  - api-key: "${LLM_BROKER_API_KEY}"
    base-url: "${LLM_BROKER_BASE_URL}"
    models:
      - name: "forbiddengun/auto-frontier"
      - name: "forbiddengun/auto-small"
      - name: "forbiddengun/auto-free"
      - name: "forbiddengun/muse"
      - name: "forbiddengun/gemini"
      - name: "forbiddengun/kimi"
      - name: "forbiddengun/qwen"
      - name: "forbiddengun/coder"
      - name: "forbiddengun/grok"
      - name: "forbiddengun/gpt"
      - name: "forbiddengun/claude"
      - name: "forbiddengun/deepseek"
      - name: "forbiddengun/glm"
      - name: "forbiddengun/mimo"
      - name: "forbiddengun/minimax"
      - name: "forbiddengun/gemma"
      - name: "forbiddengun/mistral"

# OpenCode Zen Responses API
codex-api-key:
  - api-key: "${OPENCODE_API_KEY}"
    base-url: "https://opencode.ai/zen/v1"
    models:
      - name: "muse-spark-1.3-contributor-free"
      - name: "muse-spark-1.2-contributor-free"

# OpenCode Zen Chat Completions API
openai-compatibility:
  - name: "opencode"
    base-url: "https://opencode.ai/zen/v1"
    api-key-entries:
      - api-key: "${OPENCODE_API_KEY}"
    models:
      - name: "big-pickle"
      - name: "mimo-v2.5-free"
      - name: "ling-3.0-flash-fin-free"
      - name: "nemotron-3-ultra-free"
      - name: "nemotron-3.5-lightning-free"
  - name: "orcarouter"
    base-url: "${ORCAROUTER_BASE_URL}"
    api-key-entries:
      - api-key: "${ORCAROUTER_API_KEY}"
    models:
      - name: "deepseek/deepseek-v4-flash-free"
      - name: "z-ai/glm-5.3-flash-free"
      - name: "tencent/hy3-free"

debug: true
logging-to-file: true
commercial-mode: true
usage-statistics-enabled: true
logs-max-total-size-mb: 64
routing:
  strategy: weighted-round-robin
claude-header-defaults:
  stabilize-device-profile: true
