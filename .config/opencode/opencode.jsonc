{
  // No $schema here on purpose: the published schema still describes V1
  // and suggests legacy fields V2 ignores (server, compaction.prune /
  // tail_turns, experimental.batch_tool, ...). Source of truth:
  // https://opencode.ai/v2/docs/config
  "small_model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
  },
  "agent": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
    "summary": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
  },
  "mcp": {
    "servers": {
      "remote-memory": {
        "type": "local",
        "command": ["mcp-remote-memory"],
      },
      "sandbox": {
        "type": "local",
        "command": [
          "mcp-sandbox"
        ],
      },
      "delegate": {
        "type": "local",
        "codemode": false,
        "command": [
          "mcp-delegate"
        ],
      },
      "decisions": {
        "type": "local",
        "command": [
          "mcp-decisions"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 10000,
          "execution": 130000,
        },
      },
      "lsp": {
        "type": "local",
        "command": [
          "mcp-lsp"
        ],
        "disabled": false,
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "disabled": true,
      },
    },
  },
  "providers": {
    "ckey": {
      "name": "CKey",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://api.xah.io/v1",
        "apiKey": "{env:CKEY_API_KEY}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "(?i)image",
              "(?i)veo",
              "(?i)seedance"
            ]
          }
        },
      },
      "env": [
        "CKEY_API_KEY",
      ],
      "models": {
        "forbiddengun/architect": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/gemini": {
          "capabilities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536,
          },
        },
        "forbiddengun/glm": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
        },
        "forbiddengun/deepseek": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/qwen": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
      },
    },
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todoread",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "recall",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codesearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "semantic_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "compress",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "sandbox_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "delegate_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "decisions_*",
      "resource": "*",
      "effect": "allow"
    },
  ],
  "plugins": [
    "{env:OPENCODE_LOCAL_PLUGINS}/subagent-health",
    "opencode-models-discovery@latest",
    "@tarquinen/opencode-dcp@latest",
    //"@bybrawe/opencode-loop@latest",
    //"@daytona/opencode@latest",
  ],
}
