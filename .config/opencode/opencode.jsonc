{
  // No $schema here on purpose: the published schema still describes V1
  // and suggests legacy fields V2 ignores (server, compaction.prune /
  // tail_turns, experimental.batch_tool, ...). Source of truth:
  // https://opencode.ai/v2/docs/config
  "small_model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
  },
  "agent": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
    "summary": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
  },
  "mcp": {
    "servers": {
      "opencode-decisions": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mcp-opencode-decisions"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 10000,
          "execution": 130000,
        },
      },
      "sandbox": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mcp-sandbox"
        ],
      },
      "delegate": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/mcp-delegate"
        ],
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--browser-url=http://localhost:19222"
        ],
        "disabled": true,
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "-p",
          "3.13",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd"
        ],
      },
    },
  },
  "providers": {
    "ckey": {
      "name": "CKey",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://api.xah.io/v1",
        "apiKey": "{env:CKEY_API_KEY}",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "(?i)image",
              "(?i)veo",
              "(?i)seedance"
            ]
          }
        },
      },
      "env": [
        "CKEY_API_KEY",
      ],
      "models": {
        "forbiddengun/architect": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/gemini": {
          "capabilities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536,
          },
        },
        "forbiddengun/glm": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
        },
        "forbiddengun/deepseek": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/qwen": {
          "capabilities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
      },
    },
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todoread",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "recall",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codesearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "semantic_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "compress",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "sandbox_sandbox_ro",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "sandbox_sandbox_pure",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "sandbox_sandbox_rw",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "delegate_delegate_status",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "delegate_delegate_run",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "sandbox",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_open_dashboard",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "serena_initial_instructions",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_activate_project",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_onboarding",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_list_dir",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_read_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_diagnostics_for_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_search_for_pattern",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_symbols_overview",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_symbol",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_list_memories",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_current_config",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_declaration",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_implementations",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_referencing_symbols",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_read_memory",
      "resource": "*",
      "effect": "allow"
    },
  ],
  "plugins": [
    "opencode-models-discovery@latest",
    "@tarquinen/opencode-dcp@latest",
    //"@bybrawe/opencode-loop@latest",
    //"@daytona/opencode@latest",
  ],
}
