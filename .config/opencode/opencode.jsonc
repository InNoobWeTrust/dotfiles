{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
  },
  "agent": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
    "summary": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
    "compaction": {
      "model": "kilo/~openai/gpt-luna-latest",
    },
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    //"cors": ["https://example.com"],
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ],
      "enabled": false,
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": true,
    },
  },
  "provider": {
    "proxy": {
      "name": "Local proxy",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "^gpt-image"
            ]
          }
        },
      },
      "models": {
        "haiku": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none",
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
        "sonnet": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "disabled": true,
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
        "opus": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1050000,
            "output": 128000,
          },
          "reasoning": true,
          "variants": {
            "none": {
              "disabled": true,
            },
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
      },
    },
    "ckey": {
      "name": "CKey",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.xah.io",
        "modelsDiscovery": {
          "enabled": true,
          "modelInfoFormat": "models.dev",
          "models": {
            "excludeRegex": [
              "(?i)image",
              "(?i)veo",
              "(?i)seedance"
            ]
          }
        },
      },
      "env": [
        "CKEY_API_KEY",
      ],
      "models": {
        "forbiddengun/architect": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/gemini": {
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536,
          },
        },
        "forbiddengun/glm": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
        },
        "forbiddengun/deepseek": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "forbiddengun/qwen": {
          "modalities": {
            "input": [
              "text",
            ],
            "output": [
              "text",
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
      },
    },
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todoread",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "recall",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codesearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "semantic_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "compress",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_open_dashboard",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "serena_initial_instructions",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_activate_project",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_onboarding",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_list_dir",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_read_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_diagnostics_for_file",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_search_for_pattern",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_symbols_overview",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_symbol",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_list_memories",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_get_current_config",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_declaration",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_implementations",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_find_referencing_symbols",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "serena_read_memory",
      "resource": "*",
      "effect": "allow"
    },
  ],
  "experimental": {
    "batch_tool": true,
    "openTelemetry": false,
  },
  "plugins": [
    "opencode-models-discovery@latest",
    "@tarquinen/opencode-dcp@latest",
    "@bybrawe/opencode-loop@latest",
    //"@daytona/opencode",
  ],
}
