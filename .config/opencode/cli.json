{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  }
}
