{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept",
    "sidebar": "hide",
    "verbosity": "medium"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true,
    "turn_tokens": "verbose",
    "timing": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "animations": true
}
