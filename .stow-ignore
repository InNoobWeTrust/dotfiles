# Directories and files that should stay in the repo, not be stowed to $HOME.
# One regex pattern per line, passed by bootstrap.sh as Stow --ignore flags.
# Patterns match package-relative paths and are anchored at the end by Stow.

# Repo management
bootstrap\.sh
\.stow-ignore

# Non-dotfile project dirs
\.innoobwetrust
\.opencode
# Versioned project knowledge is not a user-global memory backend.
^\.agents/memories$

# Application data and state must stay outside the dotfiles checkout.
^\.local/share$
^\.local/state$

# Hermes secrets — never stow the live .env (use .env.example)
\.hermes/\.env$

# Misc
.DS_Store
