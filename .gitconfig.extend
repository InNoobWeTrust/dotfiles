[credential]
	helper = manager-core
	helper = manager
	helper = osxkeychain
	helper = wincred
[merge]
  tool = nvim
[mergetool]
  prompt = true
[mergetool "nvim"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[difftool]
  prompt = false
[diff]
  tool = nvim

[includeIf "gitdir:~/Developer/"]
  path = ~/.gitconfig.d/.weeaboo.gitconfig
[includeIf "gitdir:~/Developer/InNoobWeTrust/"]
  path = ~/.gitconfig.d/.nerd.gitconfig
[help]
	autocorrect = 10
