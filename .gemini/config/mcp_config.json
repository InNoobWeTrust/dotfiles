{
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ],
      "command": "npx",
      "disabled": true
    },
    "sandbox": {
      "command": "mcp-sandbox",
      "disabled": false
    },
    "serena": {
      "args": [
        "-p",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "command": "uvx",
      "disabled": false
    }
  }
}
