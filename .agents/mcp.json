{
  "mcpServers": {
    "chrome-devtools": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ]
    },
    "ado": {
      "enabled": false,
      "command": "bash",
      "args": [
        "-lc",
        "npx -y @azure-devops/mcp $ADO_ORG -d core work work-items --authentication envvar"
      ]
    },
    "serena": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ]
    }
  }
}
