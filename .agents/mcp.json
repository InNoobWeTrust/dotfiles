{
  "mcpServers": {
    "sandbox": {
      "enabled": true,
      "command": "mcp-sandbox",
      "args": []
    },
    "chrome-devtools": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browser-url=http://localhost:19222"
      ]
    },
    "serena": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ]
    }
  }
}
